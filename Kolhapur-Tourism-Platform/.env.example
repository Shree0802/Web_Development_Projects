# Server Port
PORT=5000

# Authentication Secret
JWT_SECRET=kolhapur_tourism_secure_jwt_secret_key_2026

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/kolhapur_tourism

# AI Provider Configuration (Google Gemini / OpenAI)
# Optional: Set GEMINI_API_KEY to activate live Google Gemini generative travel planning
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# OpenWeatherMap API Key (Optional - Fallback provides authentic seasonal Kolhapur climate)
OPENWEATHER_API_KEY=

# Node Environment
NODE_ENV=development
