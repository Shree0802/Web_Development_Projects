{
  "name": "kolhapur-travel-and-tourism",
  "version": "2.0.0",
  "description": "Premium Kolhapur Tourism Discovery & Travel Planning Platform",
  "main": "server/src/index.js",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "node server/src/index.js",
    "seed:mongo": "cd server && node src/db/seedMongo.js",
    "test:api": "node tests/api-test.cjs",
    "test:e2e": "node tests/e2e-browser-test.cjs",
    "test": "node tests/api-test.cjs && node tests/e2e-browser-test.cjs",
    "install:all": "npm install && cd client && npm install && cd ../server && npm install",
    "install-all": "npm install && cd client && npm install && cd ../server && npm install"
  },
  "keywords": [
    "kolhapur",
    "tourism",
    "travel",
    "maharashtra",
    "heritage",
    "temples",
    "panhala-fort",
    "hotels"
  ],
  "author": "Kolhapur Tourism Platform",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2",
    "playwright": "^1.65.0"
  }
}
