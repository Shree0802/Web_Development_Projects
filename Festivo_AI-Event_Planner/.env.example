# ==============================================================================
# Festivo AI - Environment Configuration Example
# ==============================================================================

# Node Environment ('development' or 'production')
NODE_ENV=development

# Backend Server Port
PORT=5000

# Client Application URL (for CORS validation)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection URI
# Leave empty to run in zero-friction Demo Mode with local JSON file persistence
MONGODB_URI=

# Google Gemini API Key (keep server-side only; never expose to frontend)
# If empty, the intelligent celebration planning simulator will run seamlessly
GEMINI_API_KEY=

# Supported Gemini Model Identifier
AI_MODEL=gemini-2.5-flash
